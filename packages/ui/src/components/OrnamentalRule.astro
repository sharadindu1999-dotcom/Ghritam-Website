---
import Diamond from './Diamond.astro';

/** Decorative horizontal rule: hairline — diamond — hairline. Inherits `currentColor`. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['flex items-center gap-2.5', className]}>
  <div class="h-px flex-1 bg-current"></div>
  <Diamond size={6} />
  <div class="h-px flex-1 bg-current"></div>
</div>
