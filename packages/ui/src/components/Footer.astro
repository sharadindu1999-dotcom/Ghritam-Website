---
import OrnamentalRule from './OrnamentalRule.astro';

/**
 * Footer link bar. The decorative friezes (Phad / Pahadi) are placed by the
 * page directly above this bar, not by the footer itself.
 *  - standard   — three-column link bar
 *  - manuscript — ornamental rule above, 2px top rule (Product detail)
 */
interface Props {
  variant?: 'standard' | 'manuscript';
  topRule?: boolean;
}
const { variant = 'standard', topRule = false } = Astro.props;

const links = [
  { label: 'Our Story', href: '/philosophy' },
  { label: 'Farmers', href: '/philosophy' },
  { label: 'Shipping', href: '/#journal' },
  { label: 'FAQ', href: '/#journal' },
];
const social = [
  { label: 'Instagram', href: '#' },
  { label: 'WhatsApp', href: '#' },
];
---

{
  variant === 'manuscript' ? (
    <footer class="mt-auto border-t-2 border-ink px-5 pb-5 pt-7 md:px-12">
      <OrnamentalRule />
      <div
        class="mt-4 flex flex-col items-start justify-between gap-3 font-mono text-xs uppercase text-ink-2 md:flex-row md:items-center md:gap-0"
        style="letter-spacing:0.14em">
        <div class="flex flex-wrap gap-4 md:gap-6">
          {links.map((l) => (
            <a href={l.href} class="hover:text-ink">
              {l.label}
            </a>
          ))}
        </div>
        <div>© Ghritam · Bhārata, 2026</div>
        <div class="flex gap-4">
          {social.map((s) => (
            <a href={s.href} class="hover:text-ink">
              {s.label}
            </a>
          ))}
        </div>
      </div>
    </footer>
  ) : (
    <footer
      class:list={[
        'mt-auto bg-paper px-5 pb-6 pt-7 md:px-10 lg:px-14',
        topRule && 'border-t border-ink',
      ]}>
      <div
        class="flex flex-col items-start justify-between gap-3 font-mono text-xs uppercase text-ink-2 md:flex-row md:items-center md:gap-0"
        style="letter-spacing:0.18em">
        <div class="flex flex-wrap gap-4 md:gap-6">
          {links.map((l) => (
            <a href={l.href} class="hover:text-ink">
              {l.label}
            </a>
          ))}
        </div>
        <div
          class="font-serif italic normal-case tracking-normal text-ink"
          style="font-size:14px">
          Ghritam · घृतम्
        </div>
        <div class="flex flex-wrap gap-4">
          {social.map((s) => (
            <a href={s.href} class="hover:text-ink">
              {s.label}
            </a>
          ))}
          <span>© 2026</span>
        </div>
      </div>
    </footer>
  )
}
