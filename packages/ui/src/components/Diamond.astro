---
/** A small ink diamond — the system's only bullet/ornament mark. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 8, class: className } = Astro.props;
---

<span
  class:list={['inline-block rotate-45 bg-current align-middle', className]}
  style={`width:${size}px;height:${size}px`}
></span>
