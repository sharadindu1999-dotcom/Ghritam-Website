<style is:global>
  @keyframes pahadi-flag-ripple-1 { 0%,100% { transform: rotate(-3deg) translateY(0); } 50% { transform: rotate(3deg) translateY(1px); } }
  @keyframes pahadi-flag-ripple-2 { 0%,100% { transform: rotate(2deg) translateY(1px); } 50% { transform: rotate(-2deg) translateY(-1px); } }
  @keyframes pahadi-smoke { 0% { transform: translateY(0) scale(1); opacity: 0.55; } 100% { transform: translateY(-18px) scale(1.4); opacity: 0; } }
  @keyframes pahadi-stream-ripple { 0%,100% { transform: translateX(0); } 50% { transform: translateX(1px); } }
  @keyframes pahadi-cloud-drift { 0% { transform: translateX(0); } 100% { transform: translateX(-20px); } }
  .pahadi-flag { transform-box: fill-box; transform-origin: 50% 0%; }
  .pahadi-smoke { transform-box: fill-box; transform-origin: 50% 100%; }
</style>

