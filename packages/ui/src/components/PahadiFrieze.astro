          <path d="M-10 18 L -10 21 M 48 16 L 48 19" />
        </g>
      </g>

      {/* ===== Himalayan honeybee hive hanging from tree (ties to our forest honey story) ===== */}
      <g transform="translate(500 150)">
        {/* Branch */}
        <path d="M-14 0 Q 0 -4 14 0" stroke="#3a2010" stroke-width="1.2" fill="none" />
