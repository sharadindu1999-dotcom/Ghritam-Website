      {/* ===== Prayer flag string (Lungta) — animated ripple ===== */}
      <g>
        {/* Left post (deodar stick) */}
        <path d="M208 200 L 208 262" stroke="#3a2010" stroke-width="2.5" stroke-linecap="round" />
        <path d="M206 198 L 210 202" stroke="#2a1408" stroke-width="1" />
        {/* Right post */}
        <path d="M780 210 L 780 262" stroke="#3a2010" stroke-width="2.5" stroke-linecap="round" />
        {/* String */}
        <path d="M208 200 Q 494 252 780 210" stroke="#5a3818" stroke-width="0.6" fill="none" />
        {/* Flags — 5 colors cycle: blue, white, red, green, yellow (Tibetan order) */}
        {(() => {
          const flagColors = ['#3a6aaa', '#f4ead6', '#c83244', '#3a8a4a', '#e8b53a'];
          const pts = 22;
          return Array.from({length: pts}).map((_, i) => {
            const t = (i + 0.5) / pts;
            // Quadratic bezier for string: P0=(208,200) P1=(494,252) P2=(780,210)
            const x = (1-t)*(1-t)*208 + 2*(1-t)*t*494 + t*t*780;
            const y = (1-t)*(1-t)*200 + 2*(1-t)*t*252 + t*t*210 - 2;
            const color = flagColors[i % 5];
            const animDelay = (i * 0.15).toFixed(2);
            const animDur = 2 + (i % 3) * 0.4;
            return (
              <g transform={`translate(${x.toFixed(1)} ${y.toFixed(1)})`}>
              <g class="pahadi-flag" style={`animation:pahadi-flag-ripple-${(i % 2) + 1} ${animDur}s ease-in-out infinite;animation-delay:${animDelay}s`}>
                <path d="M0 0 L 16 2 L 16 16 L 0 18 Z" fill={color} stroke="#2a1a08" stroke-width="0.3" />
