                {/* Fringe */}
                <path d="M0 18 L 2 20 M 4 18 L 6 20 M 8 18 L 10 20 M 12 18 L 14 20" stroke="#2a1a08" stroke-width="0.4" />
              </g></g>
            );
          });
        })()}
