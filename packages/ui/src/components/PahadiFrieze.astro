          <ellipse cx="18" cy="14" rx="1.4" ry="0.8" />
          <ellipse cx="-14" cy="20" rx="1.4" ry="0.8" />
        </g>
        {/* Wings */}
        <g fill="#f4ead6" opacity="0.7">
          <ellipse cx="13" cy="7" rx="1.4" ry="0.5" />
          <ellipse cx="17" cy="13" rx="1.4" ry="0.5" />
          <ellipse cx="-15" cy="19" rx="1.4" ry="0.5" />
        </g>
      </g>

      {/* ===== Sun disc ===== */}
      <g transform="translate(120 80)">
        <circle cx="0" cy="0" r="14" fill="#f4d060" opacity="0.25" />
        <circle cx="0" cy="0" r="9" fill="#f4a430" stroke="#c06818" stroke-width="0.7" />
