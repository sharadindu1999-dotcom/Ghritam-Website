---
import BrandMark from './BrandMark.astro';
import CartButton from './CartButton.svelte';
import MobileMenu from './MobileMenu.svelte';

/**
 * Sticky paper top nav. Three layouts from the design directions:
 *  - minimal     — wordmark left, links centre, cart right (Home, Listing)
 *  - centered    — centred wordmark with links beneath (Philosophy)
 *  - manuscript  — margin-note feel, 2px rule (Product detail)
 *
 * The cart link is a hydrated Svelte island so its count stays live.
 */
interface Props {
  active?: 'Home' | 'Philosophy' | 'Our Foods' | 'Journal';
  variant?: 'minimal' | 'centered' | 'manuscript';
}
const { active, variant = 'minimal' } = Astro.props;

const items = [
  { label: 'Home', href: '/' },
  { label: 'Philosophy', href: '/philosophy' },
  { label: 'Our Foods', href: '/foods' },
  { label: 'Journal', href: '/journal' },
] as const;

const linkClass = (label: string) =>
  [
    'pb-0.5 transition-colors',
    active === label
      ? 'border-b border-accent text-ink'
      : 'border-b border-transparent text-ink hover:border-accent',
  ].join(' ');
---

{
  variant === 'minimal' && (
    <nav class="sticky top-0 z-50 flex items-center justify-between border-b border-ink bg-paper px-5 py-4 md:px-12 md:py-5">
      <BrandMark />
      {/* Desktop links + cart */}
      <div
        class="hidden font-mono text-sm uppercase md:flex md:gap-8"
        style="letter-spacing:0.16em">
        {items.map((i) => (
          <a href={i.href} class={linkClass(i.label)}>
            {i.label}
          </a>
        ))}
      </div>
      <div
        class="hidden font-mono text-sm uppercase md:flex md:gap-4"
        style="letter-spacing:0.16em">
        <CartButton client:load />
      </div>
      {/* Mobile hamburger */}
      <div class="md:hidden">
        <MobileMenu client:load />
      </div>
    </nav>
  )
}

{
  variant === 'centered' && (
    <nav class="sticky top-0 z-50 border-b border-ink bg-paper px-12 pb-5 pt-7 text-center">
      <div
        class="flex justify-between font-mono text-xs uppercase text-ink-3"
        style="letter-spacing:0.2em">
        <span>Est. in the cycle of harvest</span>
        <span>Delivered across Bhārata</span>
      </div>
      <div class="mt-4 font-dev text-ink" style="font-size:40px">घृतम्</div>
      <div
        class="-mt-1 font-serif italic text-ink-2"
        style="font-size:14px;letter-spacing:0.3em">
        G H R I T A M
      </div>
      <div
        class="mt-4 flex justify-center gap-10 font-mono text-sm uppercase"
        style="letter-spacing:0.16em">
        {items.map((i) => (
          <a href={i.href} class={linkClass(i.label)}>
            {i.label}
          </a>
        ))}
        <CartButton client:load />
      </div>
    </nav>
  )
}

{
  variant === 'manuscript' && (
    <nav class="sticky top-0 z-50 flex items-end justify-between border-b-2 border-ink bg-paper px-12 pb-3.5 pt-[18px]">
      <div class="pointer-events-none absolute left-0 right-0 top-0 h-2 border-b border-ink" />
      <div>
        <div
          class="mb-1 font-mono text-[9px] uppercase text-ink-3"
          style="letter-spacing:0.2em">
          ॥ श्री ॥
        </div>
        <BrandMark devSize={32} />
      </div>
      <div
        class="flex items-center gap-7 font-mono text-sm uppercase"
        style="letter-spacing:0.16em">
        {items.map((i) => (
          <a href={i.href} class={linkClass(i.label)}>
            {i.label}
          </a>
        ))}
        <span class="text-ink-3">|</span>
        <CartButton client:load />
      </div>
    </nav>
  )
}
