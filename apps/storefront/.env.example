# ─────────────────────────────────────────────────────────────────────────
# Ghritam storefront — environment variables
#
# Local:        copy to apps/storefront/.dev.vars (Wrangler reads it).
# Production:   set as Cloudflare Pages env vars (encrypt the secrets).
#
# Every var below has "Where:" telling you exactly where the value comes from.
# Vars marked (optional) have a sensible no-op fallback if unset.
# ─────────────────────────────────────────────────────────────────────────


# ── Site identity ────────────────────────────────────────────────────────

# GitHub repo holding the content (also the target of Keystatic commits).
# Format: "owner/name". Required.
# Where: the GitHub URL of this repo — e.g. github.com/<owner>/<name>.
KEYSTATIC_REPO=sharadindu1999-dotcom/Ghritam-Website

# Branch the catalog sync reads from. (optional)
# Where: usually "main".
CONTENT_REF=main

# The deployed origin. Used by the Keystatic admin's "Preview" buttons and
# by /llms.txt / sitemap so links resolve to the live site. Required in prod.
# Where: whatever URL Cloudflare Pages assigns you, or your custom domain.
PUBLIC_SITE_URL=https://ghritam.pages.dev


# ── Keystatic CMS (GitHub OAuth login) ───────────────────────────────────
# Storage is GitHub-backed in both dev and prod. The four GitHub-App values
# come from the Keystatic setup wizard the first time you visit /keystatic
# on a fresh deploy — it walks you through creating a GitHub App on the
# repo above and hands you the four values at the end.

# Where: generate locally with `openssl rand -hex 32`. Just a random string;
# don't share it. Keystatic uses it to sign its session cookies.
KEYSTATIC_SECRET=

# Where: the Keystatic setup wizard, after you create the GitHub App.
# (Also visible at github.com/settings/apps/<your-app> -> Client ID.)
KEYSTATIC_GITHUB_CLIENT_ID=

# Where: same place as the client ID. You'll need to click
# "Generate a new client secret" on the GitHub App and copy the value.
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Where: the slug Keystatic gives you (or the slug part of the GitHub App's
# public URL: github.com/apps/<slug>). It's `PUBLIC_` because the Keystatic
# UI in the browser uses it to build the install link.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=


# ── Catalog sync webhook (GitHub push -> D1) ─────────────────────────────
# Wired in DEPLOY.md section 4. When a CMS save commits to GitHub, GitHub
# fires a push webhook at /api/sync/catalog; that endpoint reads the latest
# content via the GitHub API and upserts the D1 catalog.

# Where: create a fine-grained Personal Access Token at
#   github.com/settings/personal-access-tokens
# Scope it to *only* this repo with **Contents: Read**. Required in prod.
GITHUB_TOKEN=

# Where: invent a strong random string (e.g. `openssl rand -hex 32`). Paste
# the same string into the GitHub webhook's "Secret" field at
#   github.com/<owner>/<repo>/settings/hooks
GITHUB_WEBHOOK_SECRET=

# Where: invent another random string. Lets you trigger the sync manually
# with `curl -H "Authorization: Bearer <SYNC_SECRET>" ...`. (optional)
SYNC_SECRET=


# ── Cloudflare cache purge (optional) ────────────────────────────────────
# Used by /api/sync/catalog to purge stale catalog HTML at the edge after
# a sync. Without these the s-maxage TTL (~30s) handles it naturally.

# Where: dash.cloudflare.com -> My Profile -> API Tokens -> Create Token
# Template: "Edit Cache" (or a custom token with Zone:Cache Purge).
CF_API_TOKEN=

# Where: dash.cloudflare.com -> select your domain -> right-hand sidebar
# "API" section -> "Zone ID".
CF_ZONE_ID=


# ── Razorpay (payments) ──────────────────────────────────────────────────
# Required for /checkout to work. Use the rzp_test_* keys while developing;
# switch to rzp_live_* once you've gone live in the Razorpay dashboard.

# Where: dashboard.razorpay.com -> Settings -> API Keys -> Generate Key.
# RAZORPAY_KEY_ID is safe to expose; RAZORPAY_KEY_SECRET is not.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Where: dashboard.razorpay.com -> Settings -> Webhooks -> Add new webhook.
# Set URL to https://<your-site>/api/webhooks/razorpay, subscribe to events
# `payment.captured` + `order.paid`, and invent a strong secret here +
# paste it into the webhook's Secret field.
RAZORPAY_WEBHOOK_SECRET=


# ── Order confirmation email (Resend, optional) ──────────────────────────
# Without these the order still completes; the customer just doesn't get
# an email.

# Where: resend.com -> Dashboard -> API Keys -> Create API Key.
RESEND_API_KEY=

# Where: a sender on a domain you've verified in Resend
# (resend.com -> Domains). Format: "Brand <orders@yourdomain.com>".
# If unset, falls back to onboarding@resend.dev which only emails to the
# Resend account owner — useful for testing.
ORDER_EMAIL_FROM=
