# ─────────────────────────────────────────────────────────────────────────
# Ghritam storefront — environment variables
# Copy to .dev.vars (Wrangler reads .dev.vars locally) or set as Cloudflare
# Pages secrets in production. Nothing here is needed for local Phase-1 dev.
# ─────────────────────────────────────────────────────────────────────────

# ── Catalog sync (Phase 2) ──
# GitHub repo holding the Keystatic content, "owner/name".
KEYSTATIC_REPO=your-org/ghritam
# Branch the sync reads content from.
CONTENT_REF=main
# Token used by the sync to read content files via the GitHub API.
GITHUB_TOKEN=
# Shared secret on the GitHub push webhook -> /api/sync/catalog.
GITHUB_WEBHOOK_SECRET=
# Alternative bearer secret for manually triggering the sync.
SYNC_SECRET=
# Optional: Cloudflare cache purge after a sync.
CF_API_TOKEN=
CF_ZONE_ID=

# ── Keystatic GitHub storage (production CMS) ──
# In production /keystatic logs in with GitHub. Only people the repo owner
# installs the Keystatic GitHub App on can edit anything; everyone else gets a
# "not authorised" screen at /keystatic. Every save becomes a real commit on
# `main`, so the change history IS git history — `git revert <sha>` undoes a
# wrong edit cleanly.
#
# Generate KEYSTATIC_SECRET with: openssl rand -hex 32
# The other three values come out of the GitHub App's setup wizard the first
# time you visit /keystatic in production.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# The deployed origin — used by the Keystatic admin's "Preview" buttons.
PUBLIC_SITE_URL=https://ghritam.pages.dev

# ── Razorpay + email (Phase 3) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PUBLIC_RAZORPAY_KEY_ID=
RESEND_API_KEY=
