---
import '../styles/app.css';
import CartDrawer from '@ghritam/ui/CartDrawer.svelte';
import { BRAND, organizationJsonLd, websiteJsonLd } from '../lib/seo';

/**
 * Page shell — dark "library table" body removed; canvas is paper edge-to-edge.
 * The sheet is a flex column so footers settle to the bottom of short pages.
 *
 * All pages run through this layout get a full SEO/AEO meta stack:
 * canonical URL, OpenGraph, Twitter Card, robots, plus sitewide Organization +
 * WebSite JSON-LD. Per-page schema is composed via the `jsonLd` prop.
 */
interface Props {
  title: string;
  description?: string;
  /** Override the canonical URL (defaults to the current pathname). */
  canonical?: string;
  /** Absolute or root-relative path to the OG/Twitter image. */
  ogImage?: string;
  /** OpenGraph object type. */
  ogType?: 'website' | 'article' | 'product';
  /** Set true on transactional / private pages (e.g. /checkout). */
  noindex?: boolean;
  /** schema.org JSON-LD object(s) appended after the sitewide ones. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = BRAND.defaultDescription,
  canonical,
  ogImage = '/favicon.svg',
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const fullTitle = title === BRAND.name ? title : `${title} · ${BRAND.name}`;

const siteUrl = Astro.site ?? new URL('https://ghritam.pages.dev');
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).href;

const sitewide = [organizationJsonLd(siteUrl.origin), websiteJsonLd(siteUrl.origin)];
const perPage = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allJsonLd = [...sitewide, ...perPage];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#f5efe4" />

    {/* OpenGraph */}
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_IN" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Sitemap discovery hint (the file is auto-generated by @astrojs/sitemap). */}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    {/* JSON-LD: sitewide Organization + WebSite, plus any per-page schema. */}
    {allJsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body class="bg-paper">
    <div class="sheet mx-auto flex min-h-screen w-full max-w-[1280px] flex-col">
      <slot />
    </div>
    <CartDrawer client:load />
  </body>
</html>
