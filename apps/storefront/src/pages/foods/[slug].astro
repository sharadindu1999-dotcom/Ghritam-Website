---
import { getProductBySlug, formatINR } from '@ghritam/commerce';
import { getDB } from '../../lib/db';
import { breadcrumbJsonLd, productJsonLd } from '../../lib/seo';
import Layout from '../../layouts/Layout.astro';
import TopNav from '@ghritam/ui/TopNav.astro';
import Footer from '@ghritam/ui/Footer.astro';
import Placeholder from '@ghritam/ui/Placeholder.astro';
import ProductImage from '@ghritam/ui/ProductImage.astro';
import OrnamentalRule from '@ghritam/ui/OrnamentalRule.astro';
import AddToCart from '@ghritam/ui/AddToCart.svelte';

// Edge-SSR from the D1 catalog read-replica (Phase 2).
export const prerender = false;

const { slug } = Astro.params;
const product = await getProductBySlug(slug!, getDB(Astro.locals));
if (!product) return Astro.redirect('/foods');
Astro.response.headers.set('Cache-Control', 'public, s-maxage=30, stale-while-revalidate=300');

// Phase 1 shows the default (first) variant. The variant selector + working
// "Add to cart" arrive as a Svelte island in Phase 3.
const variant = product.variants[0]!;
const thumbs = ['the label', 'the source', 'the making', 'on the table'];

const siteUrl = (Astro.site ?? new URL('https://ghritam.pages.dev')).origin;
const productSchema = productJsonLd(product, siteUrl);
const crumbs = breadcrumbJsonLd([
  { name: 'Home', url: `${siteUrl}/` },
  { name: 'Our Foods', url: `${siteUrl}/foods` },
  { name: product.name },
]);
---

<Layout
  title={product.name}
  description={`${product.origin}. ${product.note}`}
  ogType="product"
  ogImage={product.imagePath ?? '/favicon.svg'}
  jsonLd={[productSchema, crumbs]}>
  <TopNav active="Our Foods" variant="minimal" />

  {/* ── Breadcrumb ── */}
  <nav class="px-5 pt-5 font-mono text-xs uppercase text-ink-3 md:px-10 lg:px-[60px]" style="letter-spacing:0.18em">
    <a href="/">Home</a> / <a href="/foods">Our Foods</a> /
    <span class="text-ink">{product.name}</span>
  </nav>

  {/* ── Product ── */}
  <section class="grid grid-cols-1 gap-8 px-5 py-6 md:px-10 lg:grid-cols-2 lg:gap-14 lg:px-[60px] lg:py-7">
    <div>
      <ProductImage
        src={product.imagePath}
        alt={product.name}
        placeholderLabel="hero product photo"
        placeholderSublabel="the jar, morning light"
        class="h-[280px] sm:h-[360px] lg:h-[420px]"
      />
      <div class="mt-2.5 grid grid-cols-4 gap-2">
        {thumbs.map((t) => <Placeholder label={t} variant="light" class="h-[60px] lg:h-[70px]" />)}
      </div>
    </div>

    <div class="pt-2.5">
      <div class="font-mono text-xs uppercase text-ink-3" style="letter-spacing:0.22em">
        ॥ एकं फलम् ॥ — One food, one story
      </div>
      <div class="mt-2.5 font-dev leading-none" style="font-size:clamp(36px,7vw,56px)">{product.dev}</div>
      <h1 class="mt-0.5 font-serif italic" style="font-size:clamp(26px,4.5vw,36px)">{product.name}</h1>
      <div class="mt-2.5 font-mono text-xs uppercase text-ink-3" style="letter-spacing:0.16em">
        {variant.batch}
      </div>

      <OrnamentalRule class="my-[22px]" />

      <p class="font-serif text-ink-2" style="font-size:17px;line-height:1.55">
        {product.story}
      </p>

      <div class="mt-5 grid grid-cols-2 gap-6">
        <div>
          <div class="mb-1 font-mono text-[9px] uppercase text-ink-3" style="letter-spacing:0.22em">
            Price
          </div>
          <div class="font-serif" style="font-size:28px">{formatINR(variant.price)}</div>
          <div class="font-mono text-xs text-ink-3">
            for {variant.label}
            {product.variants.length > 1 && ` · ${product.variants.length} sizes`}
          </div>
        </div>
        <div>
          <div class="mb-1 font-mono text-[9px] uppercase text-ink-3" style="letter-spacing:0.22em">
            From
          </div>
          <div class="font-serif italic" style="font-size:16px">
            {product.maker.name}<br />{product.maker.place}
          </div>
        </div>
      </div>

      <div class="mt-[22px]">
        <AddToCart client:load product={product} />
      </div>

      <div
        class="mt-[18px] grid grid-cols-3 gap-2.5 font-mono text-[9px] uppercase text-ink-2"
        style="letter-spacing:0.14em">
        {product.badges.map((b) => <div>✓ {b}</div>)}
      </div>
    </div>
  </section>

  {/* ── The maker ── */}
  <section class="px-5 pb-10 pt-5 md:px-10 lg:px-[60px]">
    <OrnamentalRule class="mb-[22px] mt-2.5" />
    <div class="font-mono text-xs uppercase text-ink-3" style="letter-spacing:0.22em">
      ॥ निर्माता ॥ — The maker
    </div>
    <div class="mt-3.5 grid grid-cols-1 items-start gap-5 sm:grid-cols-[200px_1fr] sm:gap-7">
      <Placeholder label="maker portrait" class="h-[170px]" />
      <div>
        <div class="font-serif italic" style="font-size:24px">
          {product.maker.name} · {product.maker.place}
        </div>
        <p class="mt-1.5 font-serif text-ink-2" style="font-size:15px;line-height:1.55">
          {product.maker.blurb}
        </p>
      </div>
    </div>
  </section>

  <Footer variant="manuscript" />
</Layout>
