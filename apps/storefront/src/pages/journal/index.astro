---
import Layout from '../../layouts/Layout.astro';
import TopNav from '@ghritam/ui/TopNav.astro';
import Footer from '@ghritam/ui/Footer.astro';
import OrnamentalRule from '@ghritam/ui/OrnamentalRule.astro';
import { listJournal } from '../../lib/journal';
import { collectionPageJsonLd } from '../../lib/seo';

const entries = listJournal();

const siteUrl = (Astro.site ?? new URL('https://ghritam.pages.dev')).origin;
const journalJsonLd = collectionPageJsonLd({
  name: 'Journal · Ghritam',
  description:
    'Notes on food, terroir, and the body — essays from Ghritam on why whole food still matters.',
  url: `${siteUrl}/journal`,
  items: entries.map((e) => ({ name: e.title, url: `${siteUrl}/journal/${e.slug}` })),
});
---

<Layout
  title="Journal"
  description="Essays from Ghritam — on food, terroir, the body, and why the lab has not (and perhaps cannot) replace what a fruit does to a body."
  jsonLd={journalJsonLd}>
  <TopNav active="Journal" variant="minimal" />

  <header class="border-b border-ink px-5 pb-6 pt-8 md:px-10 lg:px-14 lg:pb-7 lg:pt-10">
    <div class="mb-2.5 font-mono text-xs uppercase text-ink-3" style="letter-spacing:0.3em">
      ॥ पत्रिका ॥ — Journal
    </div>
    <h1 class="font-serif italic" style="font-size:clamp(32px,6vw,52px);line-height:1;letter-spacing:-0.01em">
      Notes on food, terroir and the body.
    </h1>
  </header>

  {entries.length === 0 ? (
    <div class="px-5 py-20 text-center md:px-10 lg:px-14">
      <div class="font-dev text-accent" style="font-size:40px">रिक्तम्</div>
      <p class="mt-3 font-serif italic text-ink-2" style="font-size:18px">
        No essays yet — the first is being written.
      </p>
    </div>
  ) : (
    <div>
      {entries.map((e, i) => (
        <article class:list={["px-5 py-8 md:px-10 lg:px-14 lg:py-10", i < entries.length - 1 && 'border-b border-ink']}>
          <div class="grid grid-cols-1 gap-6 lg:grid-cols-[120px_1fr_180px] lg:items-baseline lg:gap-10">
            <div class="font-dev leading-none text-accent" style="font-size:clamp(36px,5vw,48px)">{e.devSeed}</div>
            <div>
              <a href={`/journal/${e.slug}`} class="font-serif italic leading-tight hover:text-accent" style="font-size:clamp(24px,3.5vw,32px)">
                {e.title}
              </a>
              <p class="mt-3 max-w-[640px] font-serif text-ink-2" style="font-size:15px;line-height:1.6">
                {e.excerpt}
              </p>
              <a href={`/journal/${e.slug}`} class="mt-4 inline-block border-b border-ink pb-0.5 font-mono text-xs uppercase hover:text-accent" style="letter-spacing:0.16em">
                Continue reading · {e.readingTime} min
              </a>
            </div>
            <div class="font-mono text-xs uppercase text-ink-3 lg:text-right" style="letter-spacing:0.2em">
              {e.publishedDate ?? '—'}
            </div>
          </div>
        </article>
      ))}
    </div>
  )}

  <OrnamentalRule class="mx-5 my-8 md:mx-10 lg:mx-14" />
  <Footer />
</Layout>
