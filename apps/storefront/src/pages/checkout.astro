---
import Layout from '../layouts/Layout.astro';
import TopNav from '@ghritam/ui/TopNav.astro';
import Footer from '@ghritam/ui/Footer.astro';
import Checkout from '@ghritam/ui/Checkout.svelte';
---

<Layout
  title="Checkout"
  description="Complete your Ghritam order."
  noindex>
  <TopNav active="Our Foods" variant="minimal" />

  <header class="border-b border-ink px-5 pb-6 pt-8 md:px-10 lg:px-14 lg:pb-7 lg:pt-10">
    <div class="mb-2.5 font-mono text-xs uppercase text-ink-3" style="letter-spacing:0.3em">
      ॥ कोषागार ॥ — Checkout
    </div>
    <h1 class="font-serif italic" style="font-size:clamp(32px,6vw,52px);line-height:1;letter-spacing:-0.01em">
      A few details, then payment.
    </h1>
  </header>

  <Checkout client:load />

  <Footer topRule />
</Layout>
